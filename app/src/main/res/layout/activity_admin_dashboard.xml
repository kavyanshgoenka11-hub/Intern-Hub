<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTERN HUB"
            android:textColor="#238B73"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdminWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Welcome back!"
            android:textColor="#163653"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manage internships, faculty sessions and industry insights from one place."
            android:textColor="#68788A"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="INTERNSHIP MANAGEMENT"
            android:textColor="#68788A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAdminDashboardAddInternship"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#163653"
            android:text="＋  Add Internship"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAdminDashboardViewInternships"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#FFFFFF"
            android:text="View Published Internships"
            android:textAllCaps="false"
            android:textColor="#163653"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="FACULTY MENTORSHIP"
            android:textColor="#68788A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAdminDashboardMentorship"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#238B73"
            android:text="Manage Faculty Mentorship"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="REPORTING"
            android:textColor="#68788A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAdminDashboardInsights"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FFFFFF"
            android:text="Industry Insights"
            android:textAllCaps="false"
            android:textColor="#163653"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAdminDashboardLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#FBE8E7"
            android:text="Log Out"
            android:textAllCaps="false"
            android:textColor="#B42318"
            android:textSize="15sp" />
    </LinearLayout>

</ScrollView>
