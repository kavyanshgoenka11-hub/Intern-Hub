<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnAdminBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←  Back"
            android:layout_marginTop="30dp"
            android:textColor="#3B638D"
            android:textSize="14sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Add Internship"
            android:textColor="#163653"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Publish an opportunity for students to explore."
            android:textColor="#68788A"
            android:textSize="14sp" />

        <!-- Internship title -->
        <TextView
            style="@style/FormLabel"
            android:text="Internship title *" />

        <EditText
            android:id="@+id/etTitle"
            style="@style/FormInput"
            android:hint="e.g. Software Development Intern"
            android:inputType="textCapSentences" />

        <!-- Company -->
        <TextView
            style="@style/FormLabel"
            android:text="Company name *" />

        <EditText
            android:id="@+id/etCompany"
            style="@style/FormInput"
            android:hint="e.g. Example Technologies"
            android:inputType="textCapWords" />

        <!-- Domain -->
        <TextView
            style="@style/FormLabel"
            android:text="Industry domain *" />

        <EditText
            android:id="@+id/etDomain"
            style="@style/FormInput"
            android:hint="e.g. Software Development"
            android:inputType="textCapSentences" />

        <!-- Required skills -->
        <TextView
            style="@style/FormLabel"
            android:text="Required skills *" />

        <EditText
            android:id="@+id/etSkills"
            style="@style/FormInput"
            android:hint="e.g. Java, SQL, Git"
            android:inputType="textCapSentences" />

        <!-- Description -->
        <TextView
            style="@style/FormLabel"
            android:text="Job description" />

        <EditText
            android:id="@+id/etDescription"
            style="@style/FormInput"
            android:hint="Describe the role and responsibilities"
            android:gravity="top|start"
            android:minLines="3"
            android:inputType="textCapSentences|textMultiLine" />

        <!-- Location -->
        <TextView
            style="@style/FormLabel"
            android:text="Location" />

        <EditText
            android:id="@+id/etLocation"
            style="@style/FormInput"
            android:hint="e.g. Pune"
            android:inputType="textCapWords" />

        <!-- Work mode -->
        <TextView
            style="@style/FormLabel"
            android:text="Work mode" />

        <EditText
            android:id="@+id/etWorkMode"
            style="@style/FormInput"
            android:hint="On-site, Hybrid, or Remote"
            android:inputType="textCapWords" />

        <!-- Stipend -->
        <TextView
            style="@style/FormLabel"
            android:text="Stipend" />

        <EditText
            android:id="@+id/etStipend"
            style="@style/FormInput"
            android:hint="e.g. ₹15,000 per month"
            android:inputType="textCapSentences" />

        <!-- Deadline -->
        <TextView
            style="@style/FormLabel"
            android:text="Application deadline" />

        <EditText
            android:id="@+id/etDeadline"
            style="@style/FormInput"
            android:hint="YYYY-MM-DD"
            android:inputType="date" />

        <!-- Application URL -->
        <TextView
            style="@style/FormLabel"
            android:text="Application link" />

        <EditText
            android:id="@+id/etApplicationUrl"
            style="@style/FormInput"
            android:hint="https://company.com/careers"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnSaveInternship"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="28dp"
            android:backgroundTint="#163653"
            android:text="Save Internship"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>