<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/authRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- NMIMS institutional branding -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="155dp"
                android:layout_height="102dp"
                android:src="@drawable/nmims_logo"
                android:scaleType="fitCenter"
                android:contentDescription="NMIMS official logo" />

        </LinearLayout>

        <!-- Logo -->
        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_logo"
            android:gravity="center"
            android:text="IH"
            android:textColor="#164E63"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- App name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Intern Hub"
            android:textColor="#163653"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Your career journey starts here."
            android:textColor="#68788A"
            android:textSize="14sp" />

        <!-- Authentication form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/tvAuthTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome back"
                android:textColor="#163653"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAuthSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Sign in to continue to your account."
                android:textColor="#68788A"
                android:textSize="13sp" />

            <!-- Full name: visible during registration -->
            <LinearLayout
                android:id="@+id/layoutFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Full name"
                    android:textColor="#34495E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAuthName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:hint="Enter your full name"
                    android:inputType="textCapWords"
                    android:autofillHints="name"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#163653"
                    android:textColorHint="#8492A2"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Email address"
                android:textColor="#34495E"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAuthEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:hint="you@example.com"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#163653"
                android:textColorHint="#8492A2"
                android:textSize="14sp" />

            <!-- Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Password"
                android:textColor="#34495E"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAuthPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#163653"
                android:textColorHint="#8492A2"
                android:textSize="14sp" />

            <!-- Confirm password: visible during registration -->
            <LinearLayout
                android:id="@+id/layoutConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Confirm password"
                    android:textColor="#34495E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAuthConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:hint="Re-enter your password"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#163653"
                    android:textColorHint="#8492A2"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Error and status messages -->
            <TextView
                android:id="@+id/tvAuthMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#B42318"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Authentication button -->
            <Button
                android:id="@+id/btnAuthAction"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#163653"
                android:text="Sign In"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <!-- Switch between login and registration -->
            <TextView
                android:id="@+id/btnToggleAuthMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="New here? Create an account"
                android:textColor="#3B638D"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Learn  •  Prepare  •  Connect  •  Apply"
            android:textColor="#8492A2"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>