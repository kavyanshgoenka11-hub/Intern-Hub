<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_marginTop="30dp"
            android:id="@+id/btnInsightsBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="←  Back"
            android:textColor="#3B638D"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Industry Insights"
            android:textColor="#163653"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Discover the skills requested across available internship listings."
            android:textColor="#68788A"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- Internship summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DATA SUMMARY"
                android:textColor="#68788A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInsightsCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Loading internships..."
                android:textColor="#163653"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInsightsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Calculating skills requested by employers."
                android:textColor="#68788A"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Skills chart -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Most requested skills"
            android:textColor="#163653"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Ranked by the number of approved internship listings that mention each skill."
            android:textColor="#68788A"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <!-- Java will generate the chart rows -->
        <LinearLayout
            android:id="@+id/layoutSkillBars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp" />

        <!-- Empty/error message -->
        <TextView
            android:id="@+id/tvInsightsMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#68788A"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Methodology note -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:background="#E0EEE7"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How to read these insights"
                android:textColor="#205C49"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Each skill count represents the number of approved internship listings that mention that skill. These figures describe the available listings, not the entire job market."
                android:textColor="#426B59"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
