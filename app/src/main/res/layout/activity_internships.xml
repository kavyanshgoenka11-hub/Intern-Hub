<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/internshipRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FA"
    android:padding="20dp">

    <!-- Back navigation -->
    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" ←  Back to dashboard"
        android:layout_marginTop="30dp"
        android:textColor="#3B638D"
        android:textSize="14sp"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Screen heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Explore Internships"
        android:textColor="#163653"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Discover opportunities and build your career."
        android:textColor="#68788A"
        android:textSize="14sp" />

    <!-- Number of internships -->
    <TextView
        android:id="@+id/tvInternshipCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Available internships"
        android:textColor="#163653"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Internship records will be added here by Java -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/internshipList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:gravity="center"
                android:text="Loading internships..."
                android:textColor="#68788A"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>